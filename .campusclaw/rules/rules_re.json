    {
      "id": "vav_damper_damper_control_error_overlimit_9e29c43b",
      "name": "风阀控制误差超限",
      "原因分析": "1、阀门现场安装问题\n2、风阀阀体卡住",
      "专家处理建议": "1.风阀跟现场的风阀阀体连杆之间安装角度需要调整。\n2.重启VAV",
      "meta": {
        "deviceType": "VAV",
        "component": "风阀",
        "points": [
          "damperPosition",
          "damperPositionSetpoint"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 1800
      },
      "trigger": {
