    {
      "id": "dev_rule_dd896567",
      "name": "送风压力异常",
      "原因分析": "1、压力传感器故障\\n2、压力传感器线路故障\\n3、送风压力设定值偏离变频器最小频率运行时的压力较大",
      "专家处理建议": "1、检查压力传感器阻值。\\n2、检查接线是否松动。\\n3、更改设定值到变频器最小频率运行时的压力范围以上。",
      "meta": {
        "deviceType": "送排风",
        "component": "送风机",
        "points": [
          "supplyAirPressure",
          "supplyAirPressureSp",
          "supplyAirStatus"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 900
      },
      "trigger": {
        "rule_engine": "((supplyAirStatus == 1) and ($abs((supplyAirPressure - supplyAirPressureSp)) > 20))"
      },
      "effective": {
        "metric": "ratio_true",
        "threshold": 0.9,
        "minSamples": 1
      }
    },
