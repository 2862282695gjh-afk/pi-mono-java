      "专家处理建议": "1.检查一氧化碳传感器是否烧坏。\\n2.检查一氧化碳传感器是否断线。\\n3.检查传感器量程范围是否有误。",
      "meta": {
        "deviceType": "送排风",
        "component": "排风机",
        "points": [
          "CO"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 1800
      },
      "trigger": {
        "rule_engine": "((CO < 0) or (CO > 500))"
