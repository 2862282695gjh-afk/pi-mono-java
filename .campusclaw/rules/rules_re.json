    {
      "id": "dev_rule_7d1889cb",
      "name": "送风压力恒定",
      "原因分析": "1、压力传感器故障\\n2、强制了送风机频率\\n3、阀门未开启\\n4、探测管损坏脱落",
      "专家处理建议": "1、对比检测仪数值。\\n2、释放频率强制命令。\\n3、检查送风段阀门与探测管外观。",
      "meta": {
        "deviceType": "送排风",
        "component": "送风机",
        "points": [
          "supplyAirPressure",
          "supplyAirStatus"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 3600
      },
      "trigger": {
        "rule_engine": "((supplyAirStatus == 1) and (supplyAirPressure == prev(supplyAirPressure)))"
      },
      "effective": {
        "metric": "ratio_true",
        "threshold": 1.0,
        "minSamples": 1
      }
    },
    {
      "id": "dev_overlimit_a9838a4d",
      "name": "送风压力超限",
