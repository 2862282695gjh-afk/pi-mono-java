    {
      "id": "dev_rule_08ac74fa",
      "name": "一氧化碳浓度恒定",
      "原因分析": "1、环境一氧化碳浓度稳定且较低\\n2、传感器故障\\n3、传感器线路故障",
      "专家处理建议": "1、检查传感器接线。\\n2、用万用表测量传感器供电和信号输出。\\n3、更换传感器。",
      "meta": {
        "deviceType": "送排风",
        "component": "排风机",
        "points": [
          "CO"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 3600
      },
      "trigger": {
        "rule_engine": "(CO == prev(CO))"
      },
      "effective": {
        "metric": "ratio_true",
        "threshold": 1.0,
        "minSamples": 1
      }
    },
    {
      "id": "dev_rule_06e48af2",
      "name": "一氧化碳浓度异常",
      "原因分析": "1、传感器故障\\n2、传感器线路故障\\n3、CO浓度设定值偏离正常值较大",
      "专家处理建议": "1、对比检测仪数值。\\n2、用万用表测量传感器信号接收。\\n3、检查内部电路，更换传感器。",
      "meta": {
        "deviceType": "送排风",
        "component": "排风机",
        "points": [
          "CO",
          "CO_setpoint"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 1800
      },
      "trigger": {
        "rule_engine": "(CO > (CO_setpoint * 1.1))"
      },
      "effective": {
        "metric": "ratio_true",
        "threshold": 0.9,
        "minSamples": 1
      }
    },
    {
      "id": "dev_overlimit_f66e44d7",
      "name": "一氧化碳浓度超限",
