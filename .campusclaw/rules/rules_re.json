    {
      "id": "dev_rule_a1029126",
      "name": "排风机故障",
      "原因分析": "排风机继电器过载",
      "专家处理建议": "1.更换与送风机功率适配的继电器。\\n2.更改正确的启动电流。\\n3.可适当调高热继电器的温度调节。",
      "meta": {
        "deviceType": "送排风",
        "component": "排风机",
        "points": [
          "FaultAlarm"
        ]
      },
      "window": {
        "type": "rolling",
        "durationSeconds": 60
      },
      "trigger": {
        "rule_engine": "(FaultAlarm == 1)"
      },
      "effective": {
        "metric": "ratio_true",
        "threshold": 1.0,
        "minSamples": 1
      }
    },
