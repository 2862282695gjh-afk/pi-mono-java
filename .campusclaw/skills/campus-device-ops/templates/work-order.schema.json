{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusMaintenanceWorkOrder",
  "type": "object",
  "required": ["version", "id", "status", "deviceId", "alarms", "problemAnalysis", "disposalSuggestions"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^WO-[0-9]{8}-[0-9]{3}$" },
    "status": { "enum": ["open", "in_progress", "resolved", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "deviceId": { "type": "string" },
    "deviceName": { "type": "string" },
    "building": { "type": "string" },
    "deviceType": { "type": "string" },
    "component": { "type": "string" },
    "assigneeId": { "type": "string" },
    "assigneeName": { "type": "string" },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "alarms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "ruleName"],
        "properties": {
          "ruleId": { "type": "string" },
          "ruleName": { "type": "string" },
          "reasonAnalysis": { "type": "string" },
          "expertAdvice": { "type": "string" }
        }
      }
    },
    "problemAnalysis": {
      "type": "object",
      "required": ["summary", "possibleCauses"],
      "properties": {
        "summary": { "type": "string" },
        "possibleCauses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cause", "likelihood", "evidence"],
            "properties": {
              "cause": { "type": "string" },
              "likelihood": { "enum": ["high", "medium", "low", "unknown"] },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "disposalSuggestions": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "expertAdviceRef": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
