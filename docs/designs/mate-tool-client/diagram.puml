@startuml mate_tool_client_layers
' Source evidence:
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/:
'   CallMateTool (resolveCredentials hook, MateToolExecutionException),
'   ListMateTool (agent/skill passthrough)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/mate/:
'   MateToolClient (listTools/callTool contract), MateToolMeta, MateCredentials
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/:
'   HttpMateToolClient (two-step listTools wiring, invokeTool stub DEF-007)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/util/:
'   MateRestUtil (executePostRawRequest / executeGetRawRequest)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/dto/:
'   RequestHeaderInfo (credential-free builder), ToolInfo (tool metadata result.data),
'   AgentInfo (bindingTools[].toolId), QuerySkillToolsResult/SkillBindingTool
'   (bindingTools[].id)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/config/:
'   MateToolAutoConfiguration (@Value gateway and endpoint paths), MateToolProperties
' Source baseline: superheromeZzh/pi-mono-java commit 1e9d4ee2e14717764f8403c20375c55512cbd97b
' Observed behavior: both AgentTools are stateless Spring singletons; listTools
' resolves bound tool IDs from agent/skill metadata (GET) then calls
' the tool metadata endpoint credential-free; callTool forwards agent-handed-down
' credentials; the invoke RPC is still a DEF-007 stub.
' Architecture change: outbound endpoint paths are deployment configuration
' injected with @Value; stable inbound API contract paths remain constants.
' Design reason: process-wide singleton lifetime forbids per-session state;
' permission (allow/ask/deny) enforcement stays on the Mate server.

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #475569

title Mate Tool Client Layers and Dependency Direction

package "tool/mate (AgentTool layer)" {
  class CallMateTool {
    + execute()
    # resolveCredentials(tool): MateCredentials
  }
  class ListMateTool {
    + execute()
  }
  class MateToolExecutionException
}

package "common/client (infrastructure layer)" {
  class HttpMateToolClient {
    # mateInnerGwAddress: String
    # agentInfoPathPrefix: String
    # skillToolsQueryPathPrefix: String
    # toolMetadataQueryPath: String
    + listTools(agentId, skillId)
    + callTool(tool, args, credentials)
    # queryToolIdsByAgentId(agentId)
    # queryToolIdsBySkillId(skillId)
    # queryToolMetaByIds(toolIds)
    # toMeta(List<ToolInfo>)
    # invokeTool(...) [stub DEF-007]
  }
}

package "common/client/mate (contract layer)" {
  interface MateToolClient {
    + listTools(agentId, skillId)
    + callTool(tool, args, credentials)
  }
  class MateToolMeta <<record>> {
    name / description
    inputSchema / outputSchema
    isConcurrencySafe / permission
  }
  class MateCredentials <<record>> {
    xHwId / xHwAppKey / authorization
    + appKey() / jwt()
  }
}

package "common/util + common/dto" {
  class MateRestUtil {
    + executePostRawRequest(...)
    + executeGetRawRequest(...)
  }
  class RequestHeaderInfo <<DTO>> {
    builder().build() - credential-free
  }
  class ToolInfo <<DTO>> {
    toolId / toolName / description
    inputSchema / outputSchema / permission
  }
  class AgentInfo <<DTO>> {
    bindingTools[].toolId
  }
  class QuerySkillToolsResult <<DTO>> {
    bindingTools[].id
  }
}

package "config (wiring layer)" {
  class MateToolAutoConfiguration {
    @Value mate.innerGWSerive
    @Value mate.endpoints.*
    + mateRestUtil() / mateToolClient()
    + callMateTool() / listMateTool()
  }
}

CallMateTool ..> MateToolClient : depends on contract
ListMateTool ..> MateToolClient : depends on contract
HttpMateToolClient ..|> MateToolClient : implements
HttpMateToolClient ..> MateRestUtil : gateway calls
HttpMateToolClient ..> RequestHeaderInfo : credential-free header
HttpMateToolClient ..> ToolInfo : decodes result.data
HttpMateToolClient ..> MateCredentials : forwards on callTool
MateToolAutoConfiguration ..> HttpMateToolClient : @Bean wiring

note bottom of MateToolClient
  contract lives in common/client/mate;
  dependency direction: tool/mate -> contract <- common/client
  (HttpMateToolClient does not depend on the tool layer)
end note
@enduml

@startuml mate_tool_client_dataflow
' Source evidence:
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/CallMateTool.java:
'   execute (credential hook, error propagation)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/ListMateTool.java:
'   execute (agent/skill passthrough, response formatting)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/HttpMateToolClient.java:
'   listTools (two-step: agent/skill metadata GET -> binding tool IDs,
'   then tool metadata POST), callTool (stub invoke)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/util/MateRestUtil.java:
'   executePostRawRequest, resCode/resMsg/result envelope
' Source baseline: superheromeZzh/pi-mono-java commit 1e9d4ee2e14717764f8403c20375c55512cbd97b
' Observed behavior: listMateTool resolves bound tool IDs from agent/skill
' metadata (GET), then POSTs the tool metadata endpoint credential-free;
' callMateTool forwards the call with
' resolveCredentials() output; errors become exceptions so the pipeline marks
' isError=true.
' Architecture change: all three outbound paths are injected from application
' configuration rather than hidden in static Java constants.
' Design reason: stateless tools with per-call credential resolution avoid
' cross-session leakage on the process-wide singleton client.

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #475569
skinparam SequenceMessageAlignment center

title Mate Tool Client Data Flow

actor "Model (LLM)" as llm
participant "AgentLoop" as loop
participant "ListMateTool\ntool/mate" as listTool
participant "CallMateTool\ntool/mate" as callTool
participant "HttpMateToolClient\ncommon/client" as http
participant "MateRestUtil\ncommon/util" as rest
participant "Mate inner GW\n(mate.innerGWSerive)" as gw

== listMateTool ==
llm -> loop: tool_use("listMateTool", {agent_id | skill_id})
loop -> listTool: execute
listTool -> http: listTools(agentId, skillId)
alt agentId
  http -> rest: executeGetRawRequest(gw, /agents/{agentId})
  rest -> gw: GET /mate-service/v1/agents/{agentId}
  gw --> rest: {resCode, resMsg, result: AgentInfo}
  rest --> http: raw body
  http -> http: extract bindingTools[].toolId
else skillId
  http -> rest: executeGetRawRequest(gw, /skill/info/query/{skillId})
  rest -> gw: GET /mate-service/v1/skill/info/query/{skillId}
  gw --> rest: {resCode, resMsg, result: QuerySkillToolsResult}
  rest --> http: raw body
  http -> http: extract bindingTools[].id
end
note over http
  empty ID list -> return empty tool list
  (no tool metadata call)
end note
http -> rest: executePostRawRequest(gw, toolMetadataQueryPath, headerInfo, body)
rest -> gw: POST /mate-service/v1/runtime/tools/query
note right of rest
  header: RequestHeaderInfo.builder().build()
  body: {"toolIds": [collected IDs]}
end note
gw --> rest: {resCode, resMsg, result:{data:[ToolInfo]}}
rest --> http: raw body
http -> http: resCode != 0 -> throw
http -> http: result.data -> List<ToolInfo> -> toMeta()
http --> listTool: List<MateToolMeta>
listTool --> llm: tool list (name + description + inputSchema)

== callMateTool ==
llm -> loop: tool_use("callMateTool", {tool, args})
loop -> callTool: execute
callTool -> callTool: resolveCredentials(tool)
callTool -> http: callTool(tool, args, credentials)
http -> http: invokeTool [DEF-007 stub]
alt stub throws
  http --> callTool: isError ToolResult
  callTool --> llm: MateToolExecutionException (pipeline marks isError)
else real invoke (internal)
  http -> rest: executePostRawRequest(gw, CALLTOOL, headerInfo, body)
  rest -> gw: POST tool invocation (credentials forwarded)
  gw --> rest: {resCode, resMsg, result}
  rest --> http: raw body
  alt result error
    callTool --> llm: MateToolExecutionException (pipeline marks isError)
  else success
    callTool --> llm: AgentToolResult(content, metadata)
  end
end
@enduml
