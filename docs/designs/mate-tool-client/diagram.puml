@startuml mate_tool_client_dataflow
' Source evidence:
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/CallMateTool.java:
'   execute (permission check, validateAgainstSchema, error propagation)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/ListMateTool.java:
'   execute (list + cache refresh)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/mate/MateToolClient.java:
'   listTools, callTool, ToolResult
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/HttpMateToolClient.java:
'   listTools (two-step query), callTool (invokeToolById), four DEF-007 stubs
' Source baseline: superheromeZzh/pi-mono-java PR #140 head (branch mate-tool-client)
' Observed behavior: the model discovers Mate tools via listMateTool, which refreshes
' the permission cache inside CallMateTool; each callMateTool enforces the cached
' permission, validates args locally, then invokes the tool through MateToolClient.
' Design reason: permission and validation run inside the AgentTool (not a
' before-hook) because Mate tool calls bypass ToolExecutionPipeline's tool layer.

skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #475569
skinparam SequenceMessageAlignment center

title Mate Tool Client Data Flow

actor "Model (LLM)" as llm
participant "AgentLoop" as loop
participant "ListMateTool\ntool/mate" as listTool
participant "CallMateTool\ntool/mate" as callTool
participant "MateToolClient\ncommon/client/mate" as iface
participant "HttpMateToolClient\ncommon/client" as http
participant "Mate server" as mate

== listMateTool ==
llm -> loop: tool_use("listMateTool", {agent_id | skill_id})
loop -> listTool: execute
listTool -> iface: listTools(agentId, skillId, credentials)
activate iface
iface -> http: queryToolIdsByAgentId / queryToolIdsBySkillId
http -> mate: authorized tool_id query
mate --> http: tool_id list
http -> mate: tool metadata query
mate --> http: metadata list
http --> iface: List<MateToolMeta>
deactivate iface
iface --> listTool: List<MateToolMeta>
listTool -> callTool: updateMeta(tools) - refresh permission cache
listTool --> llm: tool list (name + permission + description + inputSchema)

== callMateTool ==
llm -> loop: tool_use("callMateTool", {tool, args})
loop -> callTool: execute
callTool -> callTool: metaCache[tool].permission
alt deny
  callTool --> llm: MateToolExecutionException (pipeline marks isError)
else ask
  callTool -> callTool: MateApprovalUI.ask()
  callTool --> llm: MateToolExecutionException (user denied)
else allow (or ask approved)
  callTool -> callTool: validateAgainstSchema (required + types)
  callTool -> iface: callTool(tool, args, credentials)
  activate iface
  iface -> http: invokeToolById
  http -> mate: tool execution (X-HW credentials)
  mate --> http: execution result
  http --> iface: ToolResult
  deactivate iface
  iface --> callTool: ToolResult
  alt result.isError
    callTool --> llm: MateToolExecutionException (pipeline marks isError)
  else success
    callTool --> llm: AgentToolResult(content, metadata)
  end
end
@enduml

@startuml mate_tool_client_layers
' Source evidence:
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/:
'   CallMateTool (MateApprovalUI, MateToolExecutionException, metaCache),
'   ListMateTool
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/mate/:
'   MateToolClient, MateToolMeta, MateCredentials (top-level contract types)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/:
'   HttpMateToolClient (implements MateToolClient, four DEF-007 stubs)
' - modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/config/:
'   MateToolAutoConfiguration, MateToolProperties
' Source baseline: superheromeZzh/pi-mono-java PR #140 head (branch mate-tool-client)
' Observed behavior: the Mate contract types live in common/client/mate; both
' AgentTools and HttpMateToolClient depend only on that contract package, and
' config wires the beans behind the mate.tool.enabled switch.
' Design reason: extracting the contract from CallMateTool removes the reverse
' dependency of common/client on the tool layer, so the HTTP client stays a
' reusable infrastructure component.

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #475569

title Mate Tool Client Layers and Dependency Direction

package "tool/mate (AgentTool layer)" {
  class CallMateTool {
    - metaCache: ConcurrentHashMap
    + execute()
    + updateMeta(List<MateToolMeta>)
    + credentials(): MateCredentials
  }
  class ListMateTool {
    + execute()
  }
  interface MateApprovalUI {
    + ask(tool, args, desc): boolean
  }
  class MateToolExecutionException
}

package "common/client (infrastructure layer)" {
  class HttpMateToolClient {
    # baseUrl: String
    + listTools()
    + callTool()
    # queryToolIdsByAgentId() [stub DEF-007]
    # queryToolIdsBySkillId() [stub DEF-007]
    # queryToolMetaByIds() [stub DEF-007]
    # invokeToolById() [stub DEF-007]
  }
}

package "common/client/mate (contract layer)" {
  interface MateToolClient {
    + listTools(agentId, skillId, credentials)
    + callTool(tool, args, credentials)
  }
  class MateToolMeta <<record>> {
    name / description
    inputSchema / outputSchema
    isConcurrencySafe / permission
  }
  class MateCredentials <<record>> {
    xHwId / xHwAppKey / authorization
    + appKey() / jwt()
  }
}

package "config (wiring layer)" {
  class MateToolAutoConfiguration {
    + mateToolClient()
    + callMateTool()
    + listMateTool()
  }
  class MateToolProperties {
    enabled / baseUrl / xHwId / xHwAppKey
    approvalUi (fail-closed default)
  }
}

CallMateTool ..> MateToolClient : depends on contract
ListMateTool ..> MateToolClient : depends on contract
HttpMateToolClient ..|> MateToolClient : implements
CallMateTool ..> MateApprovalUI : approval callback
CallMateTool ..> MateToolMeta : permission cache
HttpMateToolClient ..> MateToolMeta : return type
HttpMateToolClient ..> MateCredentials : carries credentials
MateToolAutoConfiguration ..> HttpMateToolClient : @Bean wiring
MateToolAutoConfiguration ..> MateToolProperties : reads config

note bottom of MateToolClient
  contract lives in common/client/mate;
  dependency direction: tool/mate -> contract <- common/client
  (HttpMateToolClient no longer depends on the tool layer)
end note
@enduml
