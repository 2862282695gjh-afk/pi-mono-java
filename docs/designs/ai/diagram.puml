@startuml streaming-sequence
title CampusMate Provider Streaming Sequence

' Source evidence: modules/ai/src/main/java/com/campusclaw/ai/CampusClawAiService.java#streamSimple.
' Source evidence: modules/ai/src/main/java/com/campusclaw/ai/provider/AiProviderRegistry.java#getProvider.
' This change: modules/ai/src/main/java/com/campusclaw/ai/provider/mate/CampusMateProvider.java#streamSimple.
' Preserved source: modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateChatRequestMapper.java#map.
' Preserved source: modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateChatSseParser.java#accept.
' Observed behavior: provider identity wins before the optional ApiProvider fallback.

participant Caller
participant CampusClawAiService
participant AiProviderRegistry
participant CampusMateProvider
participant MateChatRequestMapper
participant CampusMate
participant MateChatSseParser
participant AssistantMessageEventStream

Caller -> CampusClawAiService : streamSimple(model, context, options)
CampusClawAiService -> AiProviderRegistry : getProvider(model.provider)
AiProviderRegistry --> CampusClawAiService : CampusMateProvider
CampusClawAiService -> CampusMateProvider : streamSimple(...)
CampusMateProvider -> MateChatRequestMapper : map context and model
CampusMateProvider -> CampusMate : POST /mate-service/v1/LLM/chat
CampusMate --> CampusMateProvider : OpenAI Chat SSE
CampusMateProvider -> MateChatSseParser : accept chunk
MateChatSseParser -> AssistantMessageEventStream : push normalized event
CampusMateProvider --> CampusClawAiService : AssistantMessageEventStream
CampusClawAiService --> Caller : AssistantMessageEventStream
Caller -> AssistantMessageEventStream : read asFlux() or result()
Caller -> AssistantMessageEventStream : cancel
AssistantMessageEventStream -> CampusMateProvider : cancel callback
CampusMateProvider -> CampusMate : close HTTP/SSE subscription
@enduml

