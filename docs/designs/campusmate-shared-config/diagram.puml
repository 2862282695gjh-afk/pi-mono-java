@startuml campusmate_shared_configuration
' Source evidence: modules/coding-agent-cli/src/main/resources/application.yml lines 89-140 at 56be8eee59415a5f86658d6635a7b7e8891263d3.
' Source evidence: MateServiceModelManagerProvider constructor, MateServiceClient constructor, and MateToolAutoConfiguration fields at the same baseline.
' Observed behavior: three configuration roots declared three service origins and seven path keys for one CampusMate service.
' Architecture change: one shared origin and six HTTP operations are consumed by all three clients.
' Security hardening: base URLs and service-local paths fail during startup when invalid.
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

package "CampusClaw" {
  component "Model Provider" as model
  component "Managed Runtime Client" as runtime
  component "Tool Client" as tool
  component "CampusMateClientProperties" as properties
  database "campusmate.base-url" as base
  collections "campusmate.endpoints\n6 HTTP operations" as endpoints
}

cloud "CampusMate Service" as campusmate

model --> properties : model chat
runtime --> properties : agent runtime and skill
tool --> properties : agent, skill, and tool
properties --> base
properties --> endpoints
base --> campusmate : one origin
endpoints --> campusmate : service-local paths

note bottom of properties
  Shared configuration only.
  Model, Runtime, and Tool
  keep separate local parameters.
end note

legend bottom
  HTTP methods, payloads, responses, and authentication are unchanged.
endlegend
@enduml

@startuml configuration_key_migration
' Source evidence: application.yml lines 89-140 at 56be8eee59415a5f86658d6635a7b7e8891263d3.
' Design reason: mate and campusmate identify the same downstream service.
' Design reason: Runtime and Tool consumed the same Skill query operation through duplicate keys.
skinparam shadowing false
left to right direction

rectangle "Observed configuration" as old {
  card "campusmate.model-manager\nbase-url + chat-path" as old_model
  card "campusmate.runtime\nbase-url + 2 paths" as old_runtime
  card "mate\ninnerGWSerive + 4 paths" as old_tool
}

rectangle "Target configuration" as target {
  card "campusmate.base-url\none required origin" as new_base
  card "campusmate.endpoints\nsix unique operations" as new_endpoints
  card "campusmate.model\nmodel-local parameters" as new_model
  card "campusmate.runtime\nruntime-local parameters" as new_runtime
  card "campusmate.tool\nenabled" as new_tool
}

old_model --> new_base
old_runtime --> new_base
old_tool --> new_base
old_model --> new_endpoints
old_runtime --> new_endpoints
old_tool --> new_endpoints
old_model --> new_model
old_runtime --> new_runtime
old_tool --> new_tool

note bottom of new_endpoints
  Runtime and Tool share one
  skill-info-path-template entry.
end note
@enduml
