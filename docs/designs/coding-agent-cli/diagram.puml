@startuml startup-sequence
title Coding Agent CLI Startup Sequence

' Source evidence: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/CampusClawApplication.java.
' Source evidence: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/cli/CampusClawCommand.java.
' Observed behavior: Spring creates the application context before Picocli dispatches a selected mode.

participant JVM
participant CampusClawApplication
participant SpringContext
participant CampusClawCommand
participant "Selected Mode" as Mode
participant AgentSession
participant Agent

JVM -> CampusClawApplication : main(args)
CampusClawApplication -> SpringContext : SpringApplication.run
SpringContext --> CampusClawApplication : inject command and factory
CampusClawApplication -> CampusClawCommand : execute(args)
CampusClawCommand -> CampusClawCommand : apply proxy and dispatch
CampusClawCommand -> AgentSession : construct model, tools, and skills
CampusClawCommand -> Mode : run(session)
Mode -> AgentSession : prompt(text)
AgentSession -> Agent : prompt(...)
Agent --> Mode : AgentEvent stream
Mode --> JVM : render output or write SSE
Mode --> CampusClawCommand : exit code
CampusClawCommand --> JVM : exit
@enduml

