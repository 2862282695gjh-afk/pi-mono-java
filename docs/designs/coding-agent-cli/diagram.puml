@startuml startup-sequence
title Default Server and Explicit CLI Startup

' Source evidence baseline: origin/main commit 3d9b9c55569486f024d6a507ce004101a56dee3f.
' Source: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/CampusClawApplication.java, CampusClawApplication#main.
' Source: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/CampusClawCliLauncher.java, CampusClawCliLauncher#run.
' Design reason: keep one executable JAR while separating web and CLI application contexts.

actor Operator
participant "CampusClawApplication" as App
participant "Spring Boot MVC" as Web
participant "CampusClawCliLauncher" as Launcher
participant "Picocli" as Cli

Operator -> App : java -jar campusclaw-agent.jar [args]
alt first argument is cli
  App -> Launcher : run(args without cli)
  Launcher -> Launcher : create non-web CLI context
  Launcher -> Cli : execute command
  Cli --> Operator : exit code
else default startup
  App -> Web : SpringApplication.run(args)
  Web --> Operator : listen on configured port
end
@enduml

