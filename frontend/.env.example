# Public, non-secret browser configuration.
VITE_CAMPUSCLAW_API_BASE=
VITE_CAMPUSCLAW_CALLER_ID=campusclaw-web
VITE_CAMPUSCLAW_AGENT_ID=agent-00000000000000000000000000000000
VITE_CAMPUSCLAW_AGENT_NAME=运营分析 Agent
VITE_CAMPUSCLAW_AGENT_DESCRIPTION=分析业务数据、定位异常，并给出可以直接执行的处理建议。
VITE_CAMPUSCLAW_AGENT_CATEGORY=校园运营
VITE_BACKEND_URL=http://localhost:8080

# Local Node development service only. Keep real values in ignored .env.local.
# Never prefix credentials with VITE_.
CAMPUSCLAW_DEV_AUTH_ACCOUNT=
CAMPUSCLAW_DEV_AUTH_PASSWORD=
